# --- .env.local (Next.js + Convex CLI) ---
# Written by `npx convex dev`: CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL, NEXT_PUBLIC_CONVEX_SITE_URL
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev (also copied to Convex env by setup)
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# --- .env (docker compose; generated by `npm run setup`) ---
APP_TIMEZONE=
APP_URL=
OPS_ALERT_EMAIL=
LENDLOOP_WEBHOOK_SECRET=
LENDLOOP_AUTOMATION_SECRET=
LENDLOOP_CONVEX_URL_FROM_N8N=
# Optional real SMTP (defaults to Mailpit)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
