[
  {
    "id": "LlSmtpCred000001",
    "name": "LendLoop SMTP",
    "type": "smtp",
    "data": {
      "host": "${SMTP_HOST}",
      "port": ${SMTP_PORT},
      "secure": ${SMTP_SECURE},
      "user": "${SMTP_USER}",
      "password": "${SMTP_PASSWORD}",
      "disableStartTls": true
    }
  },
  {
    "id": "LlWebhookSecret1",
    "name": "LendLoop webhook secret",
    "type": "crypto",
    "data": { "hmacSecret": "${LENDLOOP_WEBHOOK_SECRET}" }
  },
  {
    "id": "LlAutomationSec1",
    "name": "LendLoop automation secret",
    "type": "crypto",
    "data": { "hmacSecret": "${LENDLOOP_AUTOMATION_SECRET}" }
  }
]
