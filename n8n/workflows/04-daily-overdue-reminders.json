{
  "id": "LlOverdueRemind1",
  "name": "LendLoop · Daily overdue reminders",
  "nodes": [
    {
      "id": "every-day-at-09-00",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "run-now-cli-",
      "name": "Run now (CLI)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "overdue-request",
      "name": "Overdue request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { method: \"GET\", path: '/automation/overdue-loans', body: null } }];"
      }
    },
    {
      "id": "fetch-overdue-loans",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "LlSignedRequest1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "one-item-per-loan",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      }
    },
    {
      "id": "loop-over-loans",
      "name": "Loop over loans",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "claim-request",
      "name": "Claim request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { method: \"POST\", path: '/automation/deliveries/claim', body: { key: `reminder:${$('Loop over loans').first().json.loanId}:${$('Fetch overdue loans').first().json.asOf}`, kind: 'overdue_reminder', loanId: $('Loop over loans').first().json.loanId } } }];"
      }
    },
    {
      "id": "claim-reminder",
      "name": "Claim reminder",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "LlSignedRequest1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "should-send-",
      "name": "Should send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Should send?-c",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "send",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "render-reminder",
      "name": "Render reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "// WF2: overdue reminder for one loan (plain text).\nconst loan = $('Loop over loans').first().json;\nconst due = new Date(`${loan.endDate}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });\nconst days = loan.daysOverdue === 1 ? '1 day' : `${loan.daysOverdue} days`;\nreturn [{\n  json: {\n    to: loan.borrower.email,\n    subject: `LendLoop · Reminder: please return the ${loan.toolName}`,\n    text: `Hi ${loan.borrower.firstName},\\n\\nThe ${loan.toolName} was due back to ${loan.ownerFirstName} on ${due} (${days} ago). Please return it as soon as you can.\\n\\n${$env.LENDLOOP_APP_URL}/requests\\n\\n— LendLoop`,\n  },\n}];\n"
      }
    },
    {
      "id": "send-reminder",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "fromEmail": "LendLoop <no-reply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "LlSmtpCred000001",
          "name": "LendLoop SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "complete-sent",
      "name": "Complete sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { method: \"POST\", path: '/automation/deliveries/complete', body: { key: `reminder:${$('Loop over loans').first().json.loanId}:${$('Fetch overdue loans').first().json.asOf}`, outcome: 'sent' } } }];"
      }
    },
    {
      "id": "record-sent",
      "name": "Record sent",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "LlSignedRequest1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "complete-failed",
      "name": "Complete failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { method: \"POST\", path: '/automation/deliveries/complete', body: { key: `reminder:${$('Loop over loans').first().json.loanId}:${$('Fetch overdue loans').first().json.asOf}`, outcome: 'failed', error: String($json.error?.message ?? 'smtp error').slice(0, 200) } } }];"
      }
    },
    {
      "id": "record-failure",
      "name": "Record failure",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "LlSignedRequest1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "count-failures",
      "name": "Count failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "jsCode": "let failed = 0;\ntry { failed = $('Record failure').all().length; } catch (e) { failed = 0; }\nreturn [{ json: { failed } }];"
      }
    },
    {
      "id": "any-failure-",
      "name": "Any failure?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3740,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Any failure?-c",
              "leftValue": "={{ $json.failed > 0 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fail-run",
      "name": "Fail run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        3960,
        0
      ],
      "parameters": {
        "errorMessage": "={{ $json.failed }} overdue reminder(s) could not be sent"
      }
    }
  ],
