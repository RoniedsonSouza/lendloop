  "nodes": [
    {
      "id": "loan-event-webhook",
      "name": "Loan event webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop/loan-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "3c7e1f62-4a8b-4d5e-9f10-6c3f2a9b0001"
    },
    {
      "id": "read-raw-body",
      "name": "Read raw body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// WF1: read the exact raw request body and build the string to HMAC (\"<ts>.<raw body>\").\nconst item = $input.first();\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst headers = item.json.headers || {};\nconst ts = String(headers['x-lendloop-timestamp'] || '');\nconst signature = String(headers['x-lendloop-signature'] || '');\nreturn [{ json: { raw, ts, signature, signingInput: `${ts}.${raw}` } }];\n"
      }
    },
    {
      "id": "expected-signature",
      "name": "Expected signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingInput }}",
        "dataPropertyName": "expected",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "LlWebhookSecret1",
          "name": "LendLoop webhook secret"
        }
      }
    },
    {
      "id": "verify-signature",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// WF1: constant-time comparison of the provided signature with the one the Crypto node\n// computed (secret lives in the \"LendLoop webhook secret\" credential), plus replay window.\nconst { raw, ts, signature, expected } = $input.first().json;\nconst provided = String(signature);\nconst wanted = 'v1=' + String(expected);\nlet diff = provided.length ^ wanted.length;\nfor (let i = 0; i < wanted.length; i++) diff |= wanted.charCodeAt(i) ^ (provided.charCodeAt(i) || 0);\nconst fresh = /^\\d{1,12}$/.test(ts) && Math.abs(Date.now() / 1000 - Number(ts)) <= 300;\nlet event = null;\nif (diff === 0 && fresh) {\n  try {\n    event = JSON.parse(raw);\n  } catch {\n    event = null;\n  }\n}\nreturn [{ json: { valid: event !== null && typeof event.deliveryKey === 'string', event } }];\n"
      }
    },
    {
      "id": "signature-valid-",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Signature valid?-c",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "reject",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
